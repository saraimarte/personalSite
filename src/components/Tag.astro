---
const {tags} = Astro.props;

 
interface Props{
    tags:String[];
} 

//doesn't include the all tag, the all tag is always the first one so ill just make the tags start with the 2nd tag. 
const newTags = tags.slice(1,tags.length);

---



<div class = "tags">
    {newTags.map(tag => (
        <p class = "tag">{tag} </p>
    ))}
</div>
  

<style>
  
    .tags{
        display: flex;
        gap:0.5em;
    }
    
    .tag{
        text-decoration:none;
        background-color: blue;
        color:white;
        font-weight:bold;
        border-radius:20px;
        width:min-content;
        text-align:center;
        font-size:0.6rem;
        padding:1px 12px;
        letter-spacing: 2px;
    }

</style>