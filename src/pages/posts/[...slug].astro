---
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection , getEntry} from "astro:content";
import Tag from '@components/Tag.astro';
import BackBtn from '@components/BackBtn.astro';

import {formatDate} from '../../utils';


// Generate static paths
export async function getStaticPaths() {
  const allBlogArticles = await getCollection("blog");

  // Return an array of paths
  return allBlogArticles.map((post) => ({
    params: { slug: post.slug }, 
  }));
}

const { slug } = Astro.params;
const blog = await getEntry("blog", slug);


const { entry } = Astro.props;
const {Content} = await blog.render();

---

<MainLayout>

    <div class = "container">   
        <BackBtn link = "/posts"></BackBtn>
        <h1 class = "title">{blog.data.title}</h1>


        <div class = "dateTagsContainer">
            <p class = "date">{formatDate(blog.data.pubDate)}</p>
            <Tag tags = {blog.data.tags}></Tag>
        </div>

        <Content>
        </Content>

        <div class = "space">
        </div>
    </div>


</MainLayout>

<style>
   .container{
    min-height: 100vh; 
    width: 50%;
    margin: auto;
    padding: 20px;
    padding-bottom: 80px; 
    background-color: #F2F3F4;
    display: flex;
    flex-direction: column;
    color: #4D5E6A;
    font-size: 1.2rem;
    margin-top: 20px;
}

@media (max-width: 1000px) {
  .container{
    width: 80%;
    padding-bottom: 60px; 
   }
}

@media (max-width: 600px) {
  .container{
    width: 95%;
    padding: 20px;
    padding-bottom: 50px;
   }
}

.date {
    margin: 10px 5px;
    position: relative;
    top: 3px;
}

.title {
    margin: 10px 5px 0;
    font-size: 1.4em;
    width: 90%;
    min-height: fit-content;
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal;
    line-height: 1.3;
    display: block;
}

@media (max-width: 600px) {
    .title {
        min-height: fit-content;
        width: 95%;
    }
}

@media (max-width: 768px) {
    .title {
        width: 92%;
    }
}

.dateTagsContainer {
    display: flex;
    gap: 0.2em;
    align-items: center;
    position: relative;
    right: 6px;
    flex-wrap: wrap;
}

h1 {
    position: relative;
    right: 6px;
    max-width: 100%;
}

.container > :last-child {
    margin-bottom: 0; 
}
</style>