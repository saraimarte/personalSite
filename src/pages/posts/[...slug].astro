---
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection , getEntry} from "astro:content";
import Tag from '@components/Tag.astro';
import BackBtn from '@components/BackBtn.astro';

import {formatDate} from '../../utils';


// Generate static paths
export async function getStaticPaths() {
  const allBlogArticles = await getCollection("blog");

  // Return an array of paths
  return allBlogArticles.map((post) => ({
    params: { slug: post.slug }, 
  }));
}

const { slug } = Astro.params;
const blog = await getEntry("blog", slug);


const { entry } = Astro.props;
const {Content} = await blog.render();

---


<MainLayout>

    <div class = "container">   
        <br/>

        <BackBtn link = "/posts"></BackBtn>
         <h1 class = "title">{blog.data.title}</h1>

        <div class = "dateTagsContainer">
            <p class = "date">{formatDate(blog.data.pubDate)}</p>
            <Tag tags = {blog.data.tags}></Tag>
        </div>

        <Content>
        </Content>

    </div>

</MainLayout>

<style>
    .container{
        height:100%;
        width:50%;
        margin:auto;
        padding:20px ;
        background-color: #F2F3F4;
        display:flex;
        flex-direction: column;
        color:#4D5E6A;
        font-size:1.2rem;
    }

    @media (max-width: 1000px) {
      .container{
        width:80%;
       }
      }

    @media (max-width: 600px) {
      .container{
        width:100%;
        padding:20px;
        padding-right:25px; /* so that the Card comp looks centered in the content and not too much to the right*/
       }
      }

    .title {
        margin: 10px 5px 0;
        font-size: 1.4rem;
        overflow: hidden;
        width: 90%;
        min-height:fit-content;
    }

    .date {
        margin: 10px 5px;
        position: relative;
        top:3px;
    }
    @media (max-width: 600px) {
        .title {
            height: min-content;
            min-height: 4rem;
        }
    }

    @media (max-width: 768px) {
        .title {
            height: 65px;
        }
    }

    .dateTagsContainer{
        display: flex;
        align-items: center;
        position: relative;
        right:6px;
    }

    h1{
        position: relative;
        right:6px;
    }

    
</style>