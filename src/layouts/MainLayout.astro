---
import '@styles/Global.css';
const {pageTitle} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<link rel = "stylesheet" href = "/prism-holi-theme.css"/>
		<title>{pageTitle}</title>
	</head>

	<body>

		<slot></slot>
		<script>
		// Force immediate style application for code blocks
		document.addEventListener('DOMContentLoaded', () => {
			// Force browser to recalculate styles immediately
			const codeBlocks = document.querySelectorAll('pre[class*="language-"], code[class*="language-"]');
			
			codeBlocks.forEach((block) => {
			if (block instanceof HTMLElement) {
				// Force reflow by accessing offsetHeight
				block.offsetHeight;
				
				// Ensure correct font size is applied
				const computedStyle = window.getComputedStyle(block);
				if (computedStyle.fontSize !== '0.9rem' && !window.matchMedia('(max-width: 768px)').matches) {
				block.style.fontSize = '0.9rem';
				} else if (computedStyle.fontSize !== '0.8rem' && window.matchMedia('(max-width: 768px)').matches) {
				block.style.fontSize = '0.8rem';
				}
				
				// Force repaint
				block.style.transform = 'translateZ(0)';
				requestAnimationFrame(() => {
				block.style.transform = '';
				});
			}
			});
		});

		// Also run after any dynamic content loads
		const observer = new MutationObserver((mutations) => {
			mutations.forEach((mutation) => {
			if (mutation.type === 'childList') {
				mutation.addedNodes.forEach((node) => {
				if (node.nodeType === 1 && node instanceof Element) { // Element node
					const codeBlocks = node.querySelectorAll('pre[class*="language-"], code[class*="language-"]');
					
					codeBlocks.forEach((block) => {
					if (block instanceof HTMLElement) {
						block.offsetHeight; // Force reflow
						block.style.fontSize = window.matchMedia('(max-width: 768px)').matches ? '0.8rem' : '0.9rem';
					}
					});
				}
				});
			}
			});
		});

		observer.observe(document.body, {
			childList: true,
			subtree: true
		});
		</script>
	</body>
</html>
<style>
	@import url('https://fonts.googleapis.com/css2?family=Goudy+Bookletter+1911&family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=Merienda:wght@300..900&family=Oswald:wght@200..700&display=swap');
</style>


